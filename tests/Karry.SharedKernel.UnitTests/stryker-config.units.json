{
  "stryker-config": {
    "project": "Karry.SharedKernel.csproj",
    "test-projects": [
      "Karry.SharedKernel.UnitTests.csproj"
    ],
    "mutate": [
      "**/Units/**/*.cs"
    ],
    "configuration": "Release",
    "reporters": [
      "progress",
      "html",
      "markdown",
      "json"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 70
    },
    "concurrency": 2,
    "test-runner": "mtp"
  }
}
