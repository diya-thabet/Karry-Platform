<Project>
  <!-- Central package versions. Verified versions: docs/02-architecture/technology-stack.md §7.1.1. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- Transitive (MailKit → MimeKit): 10.0.0 has GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx; pinned to the patched servicing release. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <!-- Observability (OpenTelemetry 1.20.0: 1.20.1 is younger than the 7-day release-age rule on 2026-10-23) -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <!-- Ledger anchoring (P1.6): newest versions were younger than the 7-day release-age rule on 2026-10-23. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.4" />
    <!-- Feature flags (ADR-0019): vendor-neutral API; Karry's provider reads the database. -->
    <PackageVersion Include="OpenFeature" Version="2.14.1" />
    <PackageVersion Include="NodaTime" Version="3.3.5" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="4.5.1" />
    <!-- Testing -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.0" />
  </ItemGroup>
</Project>
