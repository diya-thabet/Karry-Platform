{
  "ConnectionStrings": {
    "Karry": "Host=127.0.0.1;Port=5432;Database=karry;Username=karry_app;Password=karry-local-only;Maximum Pool Size=50",
    "KarryOwner": "Host=127.0.0.1;Port=5432;Database=karry;Username=karry_owner;Password=karry-owner-local-only"
  },
  "Authentication": {
    "Authority": "http://localhost:8080/realms/karry",
    "Audience": "karry-api",
    "RequireHttpsMetadata": false
  },
  "RateLimits": {
    "PerAddressPerMinute": 60000,
    "AnonymousPerAddressPerMinute": 600
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:4317",
  "OTEL_METRIC_EXPORT_INTERVAL": "10000",
  "Trust": {
    "Anchoring": {
      "ServiceUrl": "http://127.0.0.1:8333",
      "Bucket": "karry-anchors",
      "AccessKey": "karry-local-access",
      "SecretKey": "karry-local-secret-only-for-dev",
      "RetentionDays": 1,
      "SigningKeyFile": "~/.karry/anchor-signing-dev.pem",
      "GenerateKeyIfMissing": true,
      "CreateBucketIfMissing": true
    }
  },
  "Storage": {
    "ServiceUrl": "http://127.0.0.1:8333",
    "Bucket": "karry-files",
    "AccessKey": "karry-local-access",
    "SecretKey": "karry-local-secret-only-for-dev",
    "CreateBucketIfMissing": true
  },
  "Identity": {
    "PortalOrigin": "http://{slug}.localhost:5173",
    "FieldOrigin": "http://{slug}.localhost:5174",
    "Keycloak": {
      "BaseUrl": "http://localhost:8080",
      "ClientSecret": "identity-local-only"
    },
    "Messaging": {
      "SmtpHost": "127.0.0.1",
      "SmtpPort": 1025,
      "RequireTls": false,
      "From": "Karry (local) <no-reply@karry.local>",
      "PhoneMode": "email-preview"
    }
  }
}
