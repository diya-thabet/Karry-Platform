<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- ASP.NET Core composition root: wires modules, middleware and health checks. -->
  <!-- The API contract is generated at build time into openapi/v1.json and committed: CI fails if it is stale and
       diffs it against main for breaking changes (oasdiff). Clients are generated from it. -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Karry.BuildingBlocks/Karry.BuildingBlocks.csproj" />
    <ProjectReference Include="..\Modules\Tenancy\Karry.Modules.Tenancy.Api\Karry.Modules.Tenancy.Api.csproj" />
    <ProjectReference Include="..\Modules\Trust\Karry.Modules.Trust.Api\Karry.Modules.Trust.Api.csproj" />
    <ProjectReference Include="..\Modules\Identity\Karry.Modules.Identity.Api\Karry.Modules.Identity.Api.csproj" />
    <ProjectReference Include="..\Modules\Billing\Karry.Modules.Billing.Api\Karry.Modules.Billing.Api.csproj" />
    <ProjectReference Include="..\Modules\Flags\Karry.Modules.Flags.Api\Karry.Modules.Flags.Api.csproj" />
    <ProjectReference Include="..\Modules\Organization\Karry.Modules.Organization.Api\Karry.Modules.Organization.Api.csproj" />
    <ProjectReference Include="..\Modules\Materials\Karry.Modules.Materials.Api\Karry.Modules.Materials.Api.csproj" />
    <ProjectReference Include="..\Modules\Assets\Karry.Modules.Assets.Api\Karry.Modules.Assets.Api.csproj" />
    <ProjectReference Include="..\Modules\Imports\Karry.Modules.Imports.Api\Karry.Modules.Imports.Api.csproj" />
    <ProjectReference Include="..\Modules\Sync\Karry.Modules.Sync.Api\Karry.Modules.Sync.Api.csproj" />
  </ItemGroup>
</Project>
