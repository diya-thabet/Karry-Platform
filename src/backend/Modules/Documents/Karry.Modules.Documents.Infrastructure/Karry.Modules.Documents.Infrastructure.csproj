<Project Sdk="Microsoft.NET.Sdk">

  <!-- Persistence (EF Core mappings, migrations) and adapters implementing Application ports: the PDF, the envelope store. -->
  <ItemGroup>
    <ProjectReference Include="../Karry.Modules.Documents.Application/Karry.Modules.Documents.Application.csproj" />
    <ProjectReference Include="../Karry.Modules.Documents.Domain/Karry.Modules.Documents.Domain.csproj" />
    <ProjectReference Include="../../../Karry.BuildingBlocks/Karry.BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fonts every PDF embeds (Documents/Fonts, SIL OFL 1.1): part of the assembly, so a deployment cannot lose them. -->
    <EmbeddedResource Include="../Fonts/*.ttf" LogicalName="Karry.Documents.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
