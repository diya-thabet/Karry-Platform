{
  "name": "@karry/i18n",
  "private": true,
  "version": "0.0.0",
  "description": "Message catalogs (ICU: fr, en, ar, emk, nqo), i18next setup, language resolution and pseudo-localization (US-P1-OFF-06).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./check": "./src/check.ts",
    "./catalogs": "./src/catalogs.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:catalogs": "node --experimental-strip-types src/check-cli.ts"
  },
  "dependencies": {
    "i18next": "catalog:",
    "i18next-icu": "catalog:",
    "intl-messageformat": "catalog:",
    "react": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
