<Project Sdk="Microsoft.NET.Sdk">
  <!-- P2.11 slice 1 (ADR-0040 §1): can PDFsharp + MigraDoc 6.2.4 (MIT, the last release before AGPL) render the
       200-entry shift report with images and embedded fonts in under 10 s? -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- Transitive (PDFsharp): 8.0.1 has GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx; the product pins the same patched release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The product's fonts (Documents module), so the spike measures what the reports will embed. -->
    <None Include="../../../../src/backend/Modules/Documents/Fonts/*.ttf" CopyToOutputDirectory="PreserveNewest" LinkBase="fonts" />
  </ItemGroup>
</Project>
